# Copy to .env and adjust. Never commit .env. Every value here has a working default for local
# development, so .env may stay empty. Validated at startup by src/config/.

# ── Public: compiled into the browser bundle, so never a secret ──

# The API origin for browser calls. Leave empty to use the page's own origin: the Vite dev
# server proxies /api to the backend, as Caddy will in production. The generated API paths
# already start with /api/v1, so this is an origin, not a path.
VITE_API_BASE_URL=""

# Public origin of this client, used to build the returnUrl handed to a bank
# during checkout. Must be reachable by the payer's browser.
VITE_PUBLIC_ORIGIN="http://localhost:5173"

# Uploaded media is served directly by object storage, not through the API. It is allowed as an
# image and audio source in the Content Security Policy.
VITE_MEDIA_BASE_URL="http://aveline-media.web.garage.localhost:3902"

# ── Server only: the rendering server reads these; the browser never sees them ──

# Where server loaders and the dev proxy reach the API.
API_INTERNAL_URL="http://localhost:3000"
