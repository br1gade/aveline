# Copy to .env and adjust. Never commit .env.
#
# Variable names depend on the bundler — Vite exposes VITE_*, Next exposes
# NEXT_PUBLIC_*. Rename these to match whatever is chosen.

# Where the backend lives. Every route is under /api/v1.
VITE_API_BASE_URL="http://localhost:3000/api/v1"

# Public origin of this client, used to build the returnUrl handed to a bank
# during checkout. Must be reachable by the payer's browser.
VITE_PUBLIC_ORIGIN="http://localhost:5173"

# Uploaded media is served directly by object storage, not through the API.
VITE_MEDIA_BASE_URL="http://aveline-media.web.garage.localhost:3902"
