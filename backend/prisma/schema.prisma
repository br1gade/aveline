  redactedAt DateTime?
  revision   Int                                @default(1)
  enquiry    SalesEnquiry                       @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  addresses  EnquiryContactAddress[]
  subjects   DataSubjectRequestEnquirySubject[]

  @@map("enquiry_contacts")
