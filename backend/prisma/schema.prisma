// Aveline — domain model
// See docs/PRODUCT_SPEC.md §4 for the rationale behind these entities.
//
// Design note: answers to the well-known operational questions (attendance,
// attribution, dietary, drink, song) are first-class columns on Rsvp because
// every operations view in §6 is a query over them. Custom host-authored
// questions fall through to RsvpQuestion / RsvpAnswer.

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Tenancy ───────────────────────────────

model Organization {
  id        String    @id @default(cuid())
  name      String
  /// Planners and agencies run many events; a couple runs one.
  kind      OrgKind   @default(HOST)
  /// Tenant closure. Soft, because the events and payments it owns are still
  /// referenced by records that must survive.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  memberships      OrganizationMembership[]
  events           Event[]
  payments         Payment[]
  messages         Message[]
  messageTemplates MessageTemplate[]
  invites          OrganizationInvite[]
  vendors          Vendor[]
  suppressions     Suppression[]
  subscription     Subscription?
  invoices         Invoice[]
  promoCodes       PromoCode[]

  enquiries SalesEnquiry[]
  enquiryConversions EnquiryConversion[]

  @@map("organizations")
}

enum OrgKind {
  HOST
  PLANNER
  CORPORATE
}

model User {
  id                String       @id @default(cuid())
  /// Stored lower-cased. Also unique on lower(email) — a functional index
  /// Prisma cannot express, created in 20261009160000_access_and_vendors and
  /// not to be dropped: without it Ani@x.am and ani@x.am were two accounts.
  email             String       @unique
  name              String
  /// Aveline's own staff. Customers are NONE; concierge operators are SUPPORT.
  platformRole      PlatformRole @default(NONE)
  /// Null for an account that has never set a password — an invited member who
  /// has not accepted, or one that will authenticate another way.
  passwordHash      String?
  isActive          Boolean      @default(true)
  /// Moved on by a password reset or "sign out everywhere". Every session and
  /// access token carries the generation it was issued in; an older one is
  /// refused at once, not when its fifteen minutes run out.
  sessionGeneration Int          @default(0)
  lastLoginAt       DateTime?
  /// Account closure. Soft rather than hard, because a deleted user is still
  /// referenced by the events they ran and the payments they authorised.
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organizationMemberships OrganizationMembership[]
  eventMemberships        EventMembership[]
  sessions                Session[]
  verificationTokens      VerificationToken[]
  deviceTokens            DeviceToken[]

  assignedEnquiries SalesEnquiry[]
  consultations Consultation[]

  @@map("users")
}

/// One refresh token, stored so a session can actually be revoked. A JWT
/// alone cannot be withdrawn before it expires, which is unacceptable for
/// staff accounts that can act on a customer's behalf.
model Session {
  id     String @id @default(cuid())
  userId String

  /// SHA-256 of the refresh token. The token itself is never stored, so a
  /// database leak does not hand over live sessions.
  tokenHash String @unique

  userAgent String?
  ipAddress String?

  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  /// The account's session generation when this was issued. A password reset
  /// or "sign out everywhere" moves the account on, and a session from an
  /// older generation is dead, however it was minted.
  generation Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Aveline staff capability. Orthogonal to customer roles: a SUPPORT operator
/// acts on a customer's event without being a member of their organization.
enum PlatformRole {
  NONE
  SUPPORT
  ADMIN
}

/// A user's standing in a customer organization. Separate from EventMembership
/// so a planner's staff can hold org-wide access or per-event access, not both
/// forced together.
model OrganizationMembership {
  id             String           @id @default(cuid())
  /// Unique: one organization per account, for now. The guard resolves "your
  /// organization" from this single row; two would make every
  /// organization-scoped route act on whichever came back first.
  userId         String           @unique
  organizationId String
  role           OrganizationRole
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

enum OrganizationRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

/// Access to one event. A planner agency assigns a coordinator to the events
/// they actually work on, and a designer who may change the invitation's look
/// without seeing guest contact details or vendor fees.
model EventMembership {
  id        String    @id @default(cuid())
  userId    String
  eventId   String
  role      EventRole
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("event_memberships")
}

enum EventRole {
  OWNER
  COORDINATOR
  DESIGNER
  VIEWER
}

// ──────────────────────────────── Event ────────────────────────────────

model Event {
  id             String    @id @default(cuid())
  organizationId String
  type           EventType
  title          String
  /// Shown on the invitation, e.g. "Anna & Davit"
  hostsLabel     String
  startsAt       DateTime
  endsAt         DateTime?
  timezone       String    @default("Asia/Yerevan")
  /// Languages this event publishes in, e.g. ["hy","ru","en"]
  locales        String[]  @default(["hy"])
  defaultLocale  String    @default("hy")

  /// Labels for the two invitation sides, e.g. "Bride" / "Groom".
  /// Drives the "which host invited you?" question and seating balance.
  sideALabel   String?
  sideBLabel   String?
  /// Per-language versions of the title and hosts: { "en": { "title": "...", "hostsLabel": "..." } }.
  /// The plain columns are the fallback when a language has none.
  translations Json    @default("{}")

  /// Who may see this event at all. PRIVATE is the default and the model the
  /// invitation flow assumes; PUBLIC opens the announcement and ticketing
  /// surfaces. See docs/PUBLIC_EVENTS.md.
  visibility EventVisibility @default(PRIVATE)

  status              EventStatus  @default(DRAFT)
  /// What the event was before it was archived, so un-archiving restores it.
  statusBeforeArchive EventStatus?

  /// Whether the scheduled RSVP reminders go out for this event.
  ///
  /// On by default, because chasing non-responders is the work hosts most want
  /// taken off them — but it writes to guests without the host pressing
  /// anything, so it has to be refusable. Some hosts chase by phone and would
  /// rather we did not.
  remindersEnabled Boolean @default(true)

  attendanceMode     AttendanceMode @default(EVENT_WIDE)
  attendanceRevision Int            @default(1)

  /// When the host let guests see their tables. Null while the plan is still
  /// being worked out: a guest shown a table that later changes walks to the
  /// wrong one (decision D4, 9 October 2026).
  seatingPublishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships         EventMembership[]
  invites             EventInvite[]
  listing             EventListing?
  ticketTypes         TicketType[]
  ticketOrders        TicketOrder[]
  tickets             Ticket[]
  messages            Message[]
  guestImports        GuestImport[]
  promoCodes          PromoCode[]
  exports             Export[]
  exportSnapshots ExportSnapshot[]
  venues              Venue[]
  timeline            TimelineEntry[]
  invitation          Invitation?
  households          Household[]
  guests              Guest[]
  tables              Table[]
  attendancePolicies  AttendancePolicy[]
  seatingArrangements SeatingArrangement[]
  mediaAssets         MediaAsset[]
  payments            Payment[]
  vendorBookings      VendorBooking[]

  @@index([organizationId])
  @@index([startsAt])
  enquiries SalesEnquiry[]
  enquiryConversions EnquiryConversion[]
  @@unique([id, organizationId])
  @@map("events")
  seatingJobs SeatingJob[]
  guestMedia GuestMedia[]
  acknowledgements GuestAcknowledgement[]
  guestPageVersion GuestPageVersion?

}

enum EventType {
  WEDDING
  ENGAGEMENT
  BAPTISM
  BIRTHDAY
  ANNIVERSARY
  CORPORATE
  OTHER
}

enum EventVisibility {
  /// Reachable only by capability link. Never indexed, never listed.
  PRIVATE
  /// Reachable by anyone with the public URL, but excluded from listings
  /// and marked noindex.
  UNLISTED
  /// Listed, indexable, and eligible for ticketing.
  PUBLIC
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  ARCHIVED
}

model Venue {
  id           String    @id @default(cuid())
  eventId      String
  /// Set when this venue came from the reusable directory rather than being
  /// typed ad hoc. Keeps a one-off address possible without a directory entry.
  profileId    String?
  role         VenueRole
  name         String
  address      String
  /// Per-language name and address: { "en": { "name": "...", "address": "..." } }; the plain columns are the fallback.
  translations Json      @default("{}")
  /// Coordinates for the map block
  latitude     Float?
  longitude    Float?
  mapUrl       String?
  arriveAt     DateTime?
  /// Seats this venue can hold for this event. Seating validates against it.
  capacity     Int?
  sortOrder    Int       @default(0)

  event              Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile            VenueProfile?       @relation(fields: [profileId], references: [id], onDelete: SetNull)
  timeline           TimelineEntry[]
  tables             Table[]
  attendanceResponses AttendanceResponse[]
  seatingArrangement SeatingArrangement?

  @@unique([id, eventId])
  @@index([eventId])
  @@map("venues")
}

/// A venue in the reusable directory, shared across events and organizations.
/// Linked to a Vendor when the venue is also a booked partner (spec §7.3).
model VenueProfile {
  id        String   @id @default(cuid())
  vendorId  String?
  name      String
  address   String
  city      String?
  latitude  Float?
  longitude Float?
  /// Typical seated capacity; a given event may seat fewer.
  capacity  Int?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  venues Venue[]

  @@index([city])
  @@index([vendorId])
  @@map("venue_profiles")
}

enum VenueRole {
  CEREMONY
  RECEPTION
  AFTER_PARTY
  PREPARATION
  OTHER
}

model TimelineEntry {
  id         String   @id @default(cuid())
  eventId    String
  venueId    String?
  /// Translated label keyed by locale: { "hy": "...", "en": "..." }
  label      Json
  occursAt   DateTime
  sortOrder  Int      @default(0)
  /// For the people running the day — "caterer arrives", "speeches cue" —
  /// not for guests. Vendors and the coordinator see it; the invitation does not.
  isInternal Boolean  @default(false)

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("timeline_entries")
}

// ───────────────────────────── Invitation ──────────────────────────────

enum InvitationLifetimeSource {
  FREE_DEFAULT
  PLAN
  LEGACY
}

model Invitation {
  id         String           @id @default(cuid())
  eventId    String           @unique
  /// Public URL segment
  slug       String           @unique
  templateId String
  /// Resolved design tokens: palette, font choices, spacing. Validated against
  /// the template's allowed sets before write (see DesignTemplate).
  theme      Json             @default("{}")
  /// How the built-in RSVP questions are asked: which are on, and the fixed
  /// choices for dietary and drink. Empty means every one on, as free text.
  rsvpFields Json             @default("{}")
  /// No cover or music columns: the cover is the HERO block's first photo
  /// and the music is the MUSIC block's audio, so each is set in one place.
  status     InvitationStatus @default(DRAFT)
  /// Invitation stays reachable until this moment; null = indefinitely
  expiresAt  DateTime?
  firstPublishedAt DateTime?
  lifetimeDays Int?
  lifetimeSource InvitationLifetimeSource?
  lifetimePlanKey String?
  expiryProcessedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template  DesignTemplate    @relation(fields: [templateId], references: [id])
  blocks    InvitationBlock[]
  questions RsvpQuestion[]

  @@index([templateId])
  @@index([expiresAt, expiryProcessedAt])
  @@index([lifetimeSource, status])
  @@map("invitations")
}

/// A template is data, not a code branch. It declares which fonts, palettes
/// and blocks a host may choose from, so "qualified users" edit design within
/// bounds the template guarantees will still render (spec §5.2).
model DesignTemplate {
  id              String      @id @default(cuid())
  key             String      @unique
  name            String
  /// Font families this template renders correctly, e.g. ["Noto Serif Armenian"]
  allowedFonts    String[]    @default([])
  /// Named palettes the host may pick, each an array of hex values
  palettes        Json        @default("[]")
  /// Block types this template supports, in their default order
  supportedBlocks BlockType[] @default([])
  /// The layouts it renders for each block, e.g. { "HERO": ["full-bleed", "split"] }.
  /// A block's variant must be one of these, or none; a block type with no
  /// entry takes no variant.
  blockVariants   Json        @default("{}")
  /// Default design tokens applied when an invitation is created
  defaultTheme    Json        @default("{}")
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  invitations Invitation[]

  @@map("design_templates")
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// One section of the invitation page. Data-bound: a block declares its type,
/// and the renderer pulls live Event data for VENUE / TIMELINE / COUNTDOWN
/// rather than duplicating it here. `content` carries only block-local copy,
/// translated per locale.
model InvitationBlock {
  id           String    @id @default(cuid())
  invitationId String
  type         BlockType
  enabled      Boolean   @default(true)
  sortOrder    Int       @default(0)
  /// Template-provided layout variant for this block, e.g. "split", "stacked".
  variant      String?
  /// Media shown by this block, ordered. Gallery uses many, hero uses one.
  assetIds     String[]  @default([])
  /// { "hy": { "title": "...", "body": "..." }, "en": { ... } }
  content      Json      @default("{}")
  /// Block-specific non-translated settings (palette swatches, toggles)
  settings     Json      @default("{}")

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, type])
  @@index([invitationId])
  @@map("invitation_blocks")
}

enum BlockType {
  HERO
  STORY
  COUNTDOWN
  MUSIC
  VENUE
  MAP
  TIMELINE
  DRESS_CODE
  NOTES
  GALLERY
  RSVP
  SIGNATURE
  CHAT
  CONTACT
}

// ──────────────────────── Guest graph (the spine) ──────────────────────

/// The unit invitations and seating operate on. Plus-ones are people who
/// belong to a household, not an integer on a guest.
model Household {
  id            String   @id @default(cuid())
  eventId       String
  name          String
  /// How many seats this household may fill in total
  seatsAllotted Int      @default(1)
  notes         String?
  createdAt     DateTime @default(now())

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests Guest[]

  @@index([eventId])
  @@map("households")
}

model Guest {
  id           String           @id @default(cuid())
  eventId      String
  householdId  String
  firstName    String
  lastName     String?
  email        String?
  phone        String?
  /// Per-guest invitation link segment. Drives §5.4 personalization.
  token        String           @unique
  locale       String?
  attribution  GuestAttribution @default(UNKNOWN)
  isPrimary    Boolean          @default(false)
  /// A guest added by the primary respondent rather than by the host
  addedByGuest Boolean          @default(false)

  /// When and how this person's details were provided. Hosts supply most
  /// guest data themselves, which is legitimate interest rather than
  /// consent — recording the source is what makes that defensible.
  consentAt     DateTime?
  consentSource String?

  /// Erasure anonymises rather than deletes. Deleting a Guest cascades to
  /// their RSVP, seat and check-in, destroying the host's record of their own
  /// event. Nulling the identifying fields removes the person while the
  /// headcount, seating and catering totals stay correct.
  anonymizedAt DateTime?

  /// Legacy release snapshot retained as migration history. Current flags are SeatRelease rows.
  seatReleasedAt          DateTime?
  seatReleasedFromTableId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event                 Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  household             Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  seatReleasedFromTable Table?         @relation("ReleasedSeats", fields: [seatReleasedFromTableId], references: [id], onDelete: SetNull)
  channels              GuestChannel[]
  rsvp                  Rsvp?
  attendanceResponses   AttendanceResponse[]
  seats                 Seat[]
  seatReleases          SeatRelease[]
  checkIn               CheckIn?
  ticket                Ticket?
  messages              Message[]
  deviceTokens          DeviceToken[]
  guestMedia GuestMedia[]
  acknowledgementsReceived GuestAcknowledgement[] @relation("AcknowledgementSubject")
  acknowledgementsSigned GuestAcknowledgement[] @relation("AcknowledgementSigner")

  @@unique([id, eventId])
  @@index([eventId])
  @@index([householdId])
  @@index([seatReleasedFromTableId])
  @@map("guests")
}

enum GuestAttribution {
  SIDE_A
  SIDE_B
  SHARED
  UNKNOWN
}

// ────────────────────────────── RSVP ───────────────────────────────────

model Rsvp {
  id      String     @id @default(cuid())
  guestId String     @unique
  status  RsvpStatus @default(PENDING)

  /// Well-known operational answers — each one feeds a view in §6.
  dietary         String[] @default([]) // → catering sheet
  dietaryNotes    String? // → catering sheet
  drinkPreference String? // → bar sheet
  songRequest     String? // → playlist
  message         String? // → guest book

  /// Set when the invitation asked the guest to sign something.
  signatureAssetId String?

  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  guest          Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  signatureAsset MediaAsset?  @relation("RsvpSignature", fields: [signatureAssetId], references: [id], onDelete: SetNull)
  answers        RsvpAnswer[]

  @@map("rsvps")
}

enum AttendanceMode {
  EVENT_WIDE
  PER_VENUE
}

/// Each transition keeps its policy and answers available as history.
model AttendancePolicy {
  id               String         @id @default(cuid())
  eventId          String
  revision         Int
  mode             AttendanceMode
  isActive         Boolean        @default(true)
  transitionId     String?
  previewToken     String?
  createdAt        DateTime       @default(now())

  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses AttendanceResponse[]

  @@unique([eventId, revision])
  @@unique([eventId, transitionId])
  @@map("attendance_policies")
}

/// scopeId is "event" or the venue ID; the SQL check prevents a mismatched scope.
model AttendanceResponse {
  id          String     @id @default(cuid())
  eventId     String
  guestId     String
  revision    Int
  scopeId     String
  venueId     String?
  status      RsvpStatus
  respondedAt DateTime?
  updatedAt   DateTime   @updatedAt

  guest  Guest            @relation(fields: [guestId, eventId], references: [id, eventId], onDelete: Cascade)
  policy AttendancePolicy @relation(fields: [eventId, revision], references: [eventId, revision], onDelete: Cascade)
  venue  Venue?           @relation(fields: [venueId, eventId], references: [id, eventId], onDelete: NoAction)

  @@unique([guestId, revision, scopeId])
  @@index([eventId, revision, venueId, status])
  @@index([venueId])
  @@map("attendance_responses")
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
  UNDECIDED
}

/// Host-authored questions beyond the well-known set.
model RsvpQuestion {
  id           String       @id @default(cuid())
  invitationId String
  type         QuestionType
  /// Translated prompt keyed by locale
  prompt       Json
  /// Translated choices for choice types
  options      Json         @default("[]")
  required     Boolean      @default(false)
  sortOrder    Int          @default(0)
  statementVersionId String? @unique

  currentStatement QuestionStatement? @relation("CurrentStatement", fields: [statementVersionId], references: [id], onDelete: SetNull)
  statements QuestionStatement[] @relation("QuestionStatements")
  acknowledgements GuestAcknowledgement[]
  invitation Invitation   @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  answers    RsvpAnswer[]

  @@index([invitationId])
  @@map("rsvp_questions")
}

enum QuestionType {
  TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  BOOLEAN
  /// Captures a drawn signature, stored as a MediaAsset. Used where a guest
  /// must acknowledge something: photo consent, a corporate waiver.
  SIGNATURE
}

model RsvpAnswer {
  id         String @id @default(cuid())
  rsvpId     String
  questionId String
  /// Scalar or array, shape depends on QuestionType
  value      Json

  rsvp     Rsvp         @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  question RsvpQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([rsvpId, questionId])
  /// Whether a question has been answered, before it is edited or deleted.
  @@index([questionId])
  @@map("rsvp_answers")
}

// ────────────────────────────── Media ──────────────────────────────────

/// Every uploaded image belongs to an event, so deleting an event reclaims its
/// storage and no asset is reachable from an unrelated invitation.
model MediaAsset {
  id                  String    @id @default(cuid())
  eventId             String
  kind                MediaKind
  url                 String
  /// Bytes; used to enforce upload limits and report storage per event.
  sizeBytes           Int?
  width               Int?
  height              Int?
  mimeType            String?
  /// Accessibility text, translated per locale.
  altText             Json      @default("{}")
  /// Smaller copies a photo is served as: [{ width, height, url, sizeBytes }].
  /// Made by a background job — resizing is not done inside a request.
  variants            Json      @default("[]")
  /// When the job made them, or found the file could not be resized; null
  /// until then, which is how the job finds its work.
  variantsProcessedAt DateTime?
  variantsError       String?
  uploadedBy          String?
  createdAt           DateTime  @default(now())

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  listingHeroes  EventListing[] @relation("ListingHero")
  exports        Export[]       @relation("ExportFile")
  rsvpSignatures Rsvp[]         @relation("RsvpSignature")

  @@index([eventId])
  /// The resizing job's queue: oldest unprocessed first.
  @@index([variantsProcessedAt, createdAt])
  @@map("media_assets")
}

enum MediaKind {
  PHOTO
  COVER
  SIGNATURE
  LOGO
  AUDIO
  /// A generated export: seating chart, place cards, catering sheet.
  DOCUMENT
}

// ───────────────────────────── Seating ─────────────────────────────────

/// A separately seated venue, or the explicitly unspecified legacy plan.
model SeatingArrangement {
  id      String  @id @default(cuid())
  eventId String
  venueId String? @unique

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue    Venue?        @relation(fields: [venueId, eventId], references: [id, eventId], onDelete: NoAction)
  tables   Table[]
  releases SeatRelease[]
  jobs     SeatingJob[]
  /// Invalidated by every seating/eligibility write, including direct SQL and cascades.
  revision Int @default(0)

  @@unique([id, eventId])
  @@unique([venueId, eventId])
  @@index([eventId])
  @@map("seating_arrangements")
}

/// Decline history is kept independently for each arrangement.
model SeatRelease {
  id            String   @id @default(cuid())
  guestId       String
  eventId       String
  arrangementId String
  tableId       String?
  releasedAt    DateTime

  guest       Guest              @relation(fields: [guestId, eventId], references: [id, eventId], onDelete: Cascade)
  arrangement SeatingArrangement @relation(fields: [arrangementId, eventId], references: [id, eventId], onDelete: Cascade)
  table       Table?             @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@unique([guestId, arrangementId])
  @@index([tableId])
  @@index([arrangementId])
  @@map("seat_releases")
}

model Table {
  id            String  @id @default(cuid())
  eventId       String
  /// Null identifies the explicit legacy/unspecified arrangement.
  venueId       String?
  /// Filled by the database from event/venue for every write, including bulk imports.
  arrangementId String  @default(dbgenerated("NULL::text"))
  name          String
  capacity      Int
  /// Free-text grouping inside a venue, e.g. "main hall", "terrace".
  zone          String?
  /// Canvas position for the seating editor
  posX          Float?
  posY          Float?
  shape         String  @default("round")

  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue         Venue?             @relation(fields: [venueId, eventId], references: [id, eventId], onDelete: NoAction)
  arrangement   SeatingArrangement @relation(fields: [arrangementId, eventId], references: [id, eventId], onDelete: NoAction)
  seats         Seat[]
  /// Historical single-seat release relation; current views read seatReleases.
  releasedSeats Guest[]            @relation("ReleasedSeats")
  seatReleases  SeatRelease[]

  @@unique([arrangementId, name])
  @@unique([id, arrangementId, eventId])
  @@index([eventId])
  @@map("tables")
}

model Seat {
  id            String   @id @default(cuid())
  tableId       String
  guestId       String
  arrangementId String   @default(dbgenerated("NULL::text"))
  eventId       String   @default(dbgenerated("NULL::text"))
  /// Place at the table, for place cards and printed plans.
  position      Int?
  assignedAt    DateTime @default(now())

  table Table @relation(fields: [tableId, arrangementId, eventId], references: [id, arrangementId, eventId], onDelete: Cascade)
  guest Guest @relation(fields: [guestId, eventId], references: [id, eventId], onDelete: Cascade)

  @@unique([guestId, arrangementId])
  @@index([arrangementId])
  @@unique([tableId, position])
  @@index([tableId])
  @@map("seats")
}

model CheckIn {
  id        String   @id @default(cuid())
  guestId   String   @unique
  arrivedAt DateTime @default(now())
  notedBy   String?

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@map("check_ins")
}

// ─────────────────────────── Vendor network ────────────────────────────

model Vendor {
  id             String         @id @default(cuid())
  /// The organization that added this vendor, which only it sees. Null is
  /// Aveline's own curated list, which every customer sees.
  organizationId String?
  name           String
  category       VendorCategory
  email          String?
  phone          String?
  notes          String?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())

  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     VendorBooking[]
  venueProfiles VenueProfile[]

  @@index([organizationId])
  @@map("vendors")
}

enum VendorCategory {
  VENUE
  CATERING
  BAR
  DECOR
  PHOTOGRAPHY
  VIDEOGRAPHY
  MUSIC
  PRINT
  OTHER
}

/// A vendor engaged for an event. `briefScopes` lists exactly which derived
/// views this vendor may read — see §7.3. Nothing outside the list is exposed.
model VendorBooking {
  id          String        @id @default(cuid())
  eventId     String
  vendorId    String
  status      BookingStatus @default(ENQUIRED)
  briefScopes String[]      @default([])
  /// Scoped access token for the vendor-facing brief
  briefToken  String        @unique
  /// The agreed fee in minor units — whole drams for AMD — like every amount
  /// of money in Aveline. Was a two-place decimal, the one exception.
  feeMinor    BigInt?
  feeCurrency String        @default("AMD")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, vendorId])
  @@index([eventId])
  @@map("vendor_bookings")
}

enum BookingStatus {
  ENQUIRED
  QUOTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ────────────────────────────── Payments ───────────────────────────────
//
// All three Armenian gateways we support are hosted-redirect gateways of the
// same shape: register an order, send the payer to the bank's form, then
// CONFIRM SERVER-TO-SERVER. The return redirect is attacker-controlled and is
// never treated as proof of payment. See docs/PAYMENTS.md.

model Payment {
  id             String  @id @default(cuid())
  organizationId String
  /// Set for a deposit or ticket; null for Aveline's own subscription billing.
  eventId        String?

  purpose  PaymentPurpose
  provider PaymentProvider

  /// Our order reference, handed to the bank. Ours so that a provider outage
  /// or a migration between banks never changes how we identify a payment.
  orderNumber String @unique

  /// Minor units as an integer. Money is never a float, and never a Decimal
  /// that someone can accidentally round: 1000 AMD is 1000, $10.50 is 1050.
  amountMinor   BigInt
  refundedMinor BigInt        @default(0)
  currency      String        @default("AMD")
  status        PaymentStatus @default(CREATED)

  /// The bank's own reference, learned at registration.
  providerRef String?
  /// Hosted form URL to send the payer to.
  redirectUrl String?
  /// Where the bank returns the payer afterwards.
  returnUrl   String?

  /// Supplied by the caller; makes retrying a registration safe.
  idempotencyKey String  @unique
  description    String?
  failureReason  String?

  authorizedAt DateTime?
  capturedAt   DateTime?
  /// Registered orders do not stay payable forever; reconciliation expires them.
  expiresAt    DateTime?
  /// When reconciliation last asked the bank. The sweep takes the longest
  /// unasked first, so payments that never settle cannot fill every batch.
  lastCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  events       PaymentEvent[]
  refunds      Refund[]

  @@index([organizationId])
  @@index([eventId])
  /// Reconciliation sweeps unresolved payments, longest unasked first.
  @@index([status, lastCheckedAt])
  @@map("payments")
}

enum PaymentPurpose {
  DEPOSIT
  TICKET
  SUBSCRIPTION
  OTHER
}

enum PaymentProvider {
  AMERIABANK
  INECOBANK
  IDBANK
  /// In-process gateway for tests and local development. Never reachable in
  /// production; selecting it there is a startup error.
  FAKE
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  EXPIRED
}

/// Every state transition with the raw provider payload that caused it.
/// Payment disputes are settled from this table, so it is append-only.
model PaymentEvent {
  id         String             @id @default(cuid())
  paymentId  String
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  source     PaymentEventSource
  /// Verbatim provider response. Never parsed for business decisions; kept so
  /// a disagreement with the bank can be reconstructed.
  payload    Json               @default("{}")
  at         DateTime           @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, at])
  @@map("payment_events")
}

enum PaymentEventSource {
  API
  CALLBACK
  RECONCILIATION
  MANUAL
}

// ──────────────────── Public events & announcements ────────────────────

/// The public face of an event: what a stranger sees and what a search engine
/// is allowed to index. Separate from Event because a private wedding has no
/// listing at all, and because its fields are presentation rather than domain.
model EventListing {
  id      String @id @default(cuid())
  eventId String @unique
  /// Public URL segment. Distinct from Invitation.slug: one is an
  /// announcement anyone may read, the other a capability link.
  slug    String @unique

  /// Translated per locale, like every other guest-facing string.
  headline Json @default("{}")
  summary  Json @default("{}")
  body     Json @default("{}")

  heroAssetId String?
  /// Free-text grouping for browse and filter, e.g. "concert", "workshop".
  categories  String[] @default([])

  /// Link-preview copy. Matters more than SEO: these events are shared in
  /// chat apps, where the preview is the first thing anyone sees.
  ogTitle       Json    @default("{}")
  ogDescription Json    @default("{}")
  ogImageId     String?

  /// Search engines are opt-in, never assumed. An UNLISTED event is always
  /// excluded regardless of this flag.
  isIndexable Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  heroAsset MediaAsset? @relation("ListingHero", fields: [heroAssetId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@map("event_listings")
}

// ─────────────────────────────── Ticketing ─────────────────────────────

/// A sellable tier. Inventory lives here and is mutated only by the atomic
/// statements in TicketInventoryService — never by read-then-write — because
/// overselling under concurrent checkout is a correctness failure, not a
/// race to be tolerated.
model TicketType {
  id      String @id @default(cuid())
  eventId String

  name        Json   @default("{}")
  description Json   @default("{}")
  priceMinor  BigInt
  currency    String @default("AMD")

  /// Capacity. `sold` counts paid tickets, `reserved` counts seats held by
  /// an in-flight checkout. Available = total - sold - reserved, and a
  /// database CHECK guarantees that never goes negative.
  quantityTotal    Int
  quantitySold     Int @default(0)
  quantityReserved Int @default(0)

  minPerOrder Int @default(1)
  maxPerOrder Int @default(10)

  salesStartAt DateTime?
  salesEndAt   DateTime?
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items   TicketOrderItem[]
  tickets Ticket[]
  attendees OrderAttendee[]

  @@unique([id, eventId])
  @@index([eventId, isActive])
  @@map("ticket_types")
}

model TicketOrder {
  id      String @id @default(cuid())
  eventId String

  /// Buyers are not Users. A stranger buying a ticket must not need an
  /// account, the same reasoning that makes guests capability-based.
  buyerName  String
  buyerEmail String
  buyerPhone String?
  locale     String  @default("hy")

  status     TicketOrderStatus @default(RESERVED)
  totalMinor BigInt
  currency   String            @default("AMD")

  /// Set once a payment is registered. Nullable because free events exist.
  paymentOrderNumber String?   @unique
  /// Held inventory is released after this moment by the reservation sweep.
  reservesUntil      DateTime?
  /// Supplied by the client; makes a double-tapped checkout safe.
  idempotencyKey     String    @unique
  requestFingerprint String?
  cancellationStartedAt DateTime?

  /// Applied discount, captured so a later code change never rewrites what
  /// a buyer was actually charged.
  promoCodeId   String?
  discountMinor BigInt  @default(0)

  /// Capability token for the buyer's own order page.
  accessToken String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promoCode PromoCode?        @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items     TicketOrderItem[]
  tickets   Ticket[]
  attendees OrderAttendee[]

  @@unique([id, eventId])
  @@index([eventId, status])
  /// The reservation sweep scans expiring holds oldest-first.
  @@index([status, reservesUntil])
  /// The notice sweep reads the last week's settled orders.
  @@index([status, updatedAt])
  @@map("ticket_orders")
}

enum TicketOrderStatus {
  /// Inventory held, payment not yet settled.
  RESERVED
  PAID
  CANCELLED
  /// The hold lapsed before payment; inventory has been returned.
  EXPIRED
  REFUNDED
}

model TicketOrderItem {
  id             String @id @default(cuid())
  orderId        String
  ticketTypeId   String
  quantity       Int
  /// Captured at purchase so a later price change never rewrites history.
  unitPriceMinor BigInt

  order      TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@unique([orderId, ticketTypeId])
  /// Whether a ticket type has been ordered, before it is deleted.
  @@index([ticketTypeId])
  @@map("ticket_order_items")
}

/// One admitted person. Issued only after payment settles.
model Ticket {
  id           String @id @default(cuid())
  eventId      String
  orderId      String
  ticketTypeId String

  /// Printed and encoded into the QR. Unguessable, because possession is
  /// what admits someone.
  code        String  @unique
  holderName  String?
  holderEmail String?

  status   TicketStatus @default(VALID)
  issuedAt DateTime     @default(now())
  usedAt   DateTime?
  /// Set when a ticket holder is also tracked in the guest graph, which lets
  /// seating and catering treat both populations the same way.
  guestId  String?      @unique
  attendeeId String?    @unique

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order      TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  guest      Guest?      @relation(fields: [guestId, eventId], references: [id, eventId], onDelete: NoAction)
  attendee   OrderAttendee? @relation(fields: [attendeeId, eventId], references: [id, eventId], onDelete: NoAction)

  @@unique([guestId, eventId])
  @@unique([attendeeId, eventId])
  @@index([eventId, status])
  /// Voiding an order's tickets and listing them filter by order.
  @@index([orderId])
  @@map("tickets")
}

/// Checkout intent belongs to the attendee, independently of the buyer.
model OrderAttendee {
  id          String @id @default(cuid())
  orderId     String
  eventId     String
  ticketTypeId String
  position    Int
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  locale      String
  householdKey String?
  generatedGuestId String? @unique
  linkedSourceSnapshot Json?
  dietary     String[] @default([])
  dietaryNotes String?
  drinkPreference String?
  answers     Json @default("[]")
  attendanceRevision Int
  status      RsvpStatus
  venueAttendance Json @default("[]")
  erasedAt    DateTime?

  order TicketOrder @relation(fields: [orderId, eventId], references: [id, eventId], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId, eventId], references: [id, eventId], onDelete: NoAction)
  ticket Ticket?

  @@unique([id, eventId])
  @@unique([orderId, position])
  @@index([ticketTypeId])
  @@index([email])
  @@index([eventId])
  @@map("order_attendees")
}

enum TicketStatus {
  VALID
  /// Admitted. Set once, so a code cannot be reused at the door.
  USED
  VOID
  REFUNDED
}

// ───────────────────────────── Communications ──────────────────────────
//
// Until now nothing in the system could actually reach a guest. Invitations
// were links someone copied by hand. These models give the product a way to
// send, and — more importantly — a record of what was sent and what happened.

/// Reusable copy for one kind of message, translated per locale. Templates are
/// rows rather than code so copy changes do not need a deployment, and so an
/// organization can override the default wording.
model MessageTemplate {
  id             String         @id @default(cuid())
  /// Null for an Aveline default; set when an organization overrides it.
  organizationId String?
  /// Stable identifier, e.g. "invitation.send", "rsvp.reminder".
  key            String
  channel        MessageChannel

  subject Json @default("{}")
  body    Json @default("{}")

  /// For channels that only accept pre-registered templates — WhatsApp — the
  /// provider's own template name, and the variable names in the order the
  /// provider expects them as positional parameters. Null for channels that
  /// take the rendered `body` as it is.
  providerTemplate String?
  providerParams   String[] @default([])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Covers organization overrides. Global templates (organizationId NULL) are
  /// made unique by the partial index in 20261004170000, because Postgres
  /// treats NULLs as distinct and this constraint alone would not bind them.
  @@unique([organizationId, key, channel])
  @@map("message_templates")
}

/// Shared SMTP budget. Correct after process or Redis restarts, not a cache.
model EmailSendQuota {
  scope        String   @id
  credits      BigInt
  refilledAt   DateTime
  dayStartedAt DateTime
  usedToday    Int      @default(0)

  @@map("email_send_quotas")
}

/// Normalized email feedback, without provider payloads or recipient addresses.
model EmailFeedback {
  receiptKey  String               @id
  messageId   String
  outcome     EmailFeedbackOutcome
  occurredAt  DateTime
  receivedAt  DateTime             @default(now())
  lastCheckedAt DateTime?
  processedAt DateTime?

  /// Acknowledgement can follow callback; unmatched work is bounded by time.
  @@index([processedAt, receivedAt])
  @@index([processedAt, lastCheckedAt, receivedAt])
  @@map("email_feedback")
}

enum EmailFeedbackOutcome {
  DELIVERED
  HARD_BOUNCE
  SOFT_BOUNCE
  COMPLAINT
}

/// Durable, scoped provider outcomes; never contacts, message bodies or raw payloads.
model WhatsAppReceipt {
  receiptKey    String @id
  accountId     String
  phoneNumberId String
  providerRef   String
  outcome       WhatsAppReceiptOutcome
  occurredAt    DateTime
  errorCode     Int?
  receivedAt    DateTime @default(now())
  lastCheckedAt DateTime?
  processedAt   DateTime?

  @@index([processedAt, lastCheckedAt, receivedAt])
  @@index([processedAt, receivedAt])
  @@map("whatsapp_receipts")
}

enum WhatsAppReceiptOutcome {
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppDeliveryFailureKind {
  CONFIGURATION
  TRANSIENT
  AMBIGUOUS
  UNKNOWN
}

/// One outbound message. Written in the same transaction as the action that
/// causes it and dispatched afterwards — an outbox — so a send can never be
/// lost because the process died between committing and calling the provider.
model Message {
  id String @id @default(cuid())

  /// Null for platform mail that belongs to no tenant: a password reset, an
  /// email verification, an invitation to join an organization the recipient
  /// is not yet in. Those go through the same outbox as everything else, so
  /// they get the same retry, suppression and bounce handling — which is why
  /// this is nullable rather than them bypassing it.
  organizationId String?
  eventId        String?
  /// Set when the recipient is a known guest, which is what lets delivery
  /// failures surface against a name rather than an address.
  guestId        String?

  /// Outbound today. The field exists so receiving a reply later is an
  /// additive change rather than a reshape of a table with history in it.
  direction   MessageDirection @default(OUTBOUND)
  channel     MessageChannel
  /// Groups a message with its replies. Null until two-way messaging exists;
  /// a provider's conversation id goes here when it does.
  threadKey   String?
  templateKey String?
  /// Email address, phone number or chat id, depending on channel.
  toAddress   String
  locale      String           @default("hy")

  /// Rendered at enqueue time, so what was sent stays knowable even after
  /// the template changes.
  subject String?
  body    String

  /// For a channel that only sends registered templates (WhatsApp): which
  /// template carried this message and the parameters it was given, resolved
  /// at enqueue for the same reason the body is. Null on channels that send
  /// the body as it is.
  providerTemplate String?
  providerParams   String[] @default([])

  status        MessageStatus @default(QUEUED)
  /// Higher goes first. Account, ticket and confirmation mail is waited on by
  /// someone at a screen; a bulk send is not. See message-priority.ts.
  priority      Int           @default(0)
  attempts      Int           @default(0)
  providerRef   String?
  providerAccountId String?
  providerSenderId  String?
  providerStatusAt DateTime?
  readAt DateTime?
  deliveryFailedAt DateTime?
  deliveryErrorCode Int?
  deliveryFailureKind WhatsAppDeliveryFailureKind?
  failureReason String?

  scheduledFor DateTime  @default(now())
  sentAt       DateTime?
  deliveredAt  DateTime?

  /// Makes retries and double-clicks safe: the same logical message is only
  /// ever enqueued once.
  dedupeKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  guest        Guest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)

  // Null scope on historical/other-channel messages intentionally remains unmatched.
  @@unique([channel, providerAccountId, providerSenderId, providerRef])
  /// The dispatcher claims due work highest priority first, then oldest.
  @@index([status, priority, scheduledFor])
  @@index([threadKey])
  @@index([eventId])
  /// Who was invited, reminded, confirmed — per guest and kind of message.
  @@index([guestId, templateKey])
  @@map("messages")
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

/// How one guest can be reached on one channel.
///
/// A table rather than columns on Guest, because these arrive at different
/// times and by different routes: a host types an email, a guest opts into
/// Telegram themselves by tapping a deep link, and Viber would otherwise be a
/// third column nobody remembers to populate.
model GuestChannel {
  id      String         @id @default(cuid())
  guestId String
  channel MessageChannel

  /// A Telegram chat id, an E.164 phone number, or an email address —
  /// whatever the channel's transport addresses a recipient by.
  address String

  /// When the guest themselves opted in, as opposed to the host supplying the
  /// address. Telegram requires the guest to start the conversation, so for
  /// that channel this is never null — and it is the record that they did.
  optedInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  /// One address per guest per channel. A second Telegram account for the same
  /// guest is a replacement, not an addition.
  @@unique([guestId, channel])
  @@index([channel, address])
  @@map("guest_channels")
}

enum MessageChannel {
  EMAIL
  SMS
  /// Both chat channels carry a link rather than the invitation itself; the
  /// preview metadata is what makes them work.
  TELEGRAM
  WHATSAPP
  PUSH
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  /// Confirmed by the provider, not merely accepted by it.
  DELIVERED
  FAILED
  BOUNCED
  /// Recipient opted out; never attempted.
  SUPPRESSED
  /// Withdrawn before it was sent, because what it said no longer applied —
  /// a reminder to answer, for a household that has since answered.
  CANCELLED
}

// ─────────────────────── Data-subject requests ─────────────────────────

/// A person asking what is held about them, or asking for it to go.
///
/// Tracked as a row because the obligation has a clock: a response is due
/// within one month, and being able to show *when* a request arrived and what
/// was done is the point. An ad-hoc deletion leaves no evidence it happened.
///
/// Note that `Rsvp.dietary` and `dietaryNotes` are special-category data under
/// GDPR — they can reveal health or religion — so an erasure must clear them
/// even though they look operational.
model DataSubjectRequest {
  id     String                   @id @default(cuid())
  kind   DataSubjectRequestKind
  status DataSubjectRequestStatus @default(RECEIVED)

  /// How the requester identified themselves. They may be a guest with no
  /// account, so an address is the only reliable handle.
  subjectEmail   String?
  subjectSource DataSubjectSource @default(EMAIL)
  enquirySubjectsVerifiedAt DateTime?
  erasureAppliedAt DateTime?
  erasureCheckpointId String?
  erasureResult Json?
  enquirySubjects DataSubjectRequestEnquirySubject[]
  organizationId String?
  guestId        String?
  userId         String?

  requestedAt DateTime  @default(now())
  /// One month from receipt, per GDPR Article 12.
  dueAt       DateTime
  completedAt DateTime?

  /// Where an export landed, when the request was for one.
  resultAssetId   String?
  handledByUserId String?
  notes           String?

  @@index([status, dueAt])
  @@index([subjectEmail])
  @@map("data_subject_requests")
}

enum DataSubjectRequestKind {
  /// Article 15 — a copy of what is held.
  EXPORT
  /// Article 17 — erasure.
  ERASURE
  /// Article 16 — correction.
  RECTIFICATION
}

enum DataSubjectRequestStatus {
  RECEIVED
  /// Identity not yet established. Acting on an unverified request is itself
  /// a breach.
  VERIFYING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

// ──────────────────────────── Push delivery ────────────────────────────

/// A device that can receive a push notification.
///
/// MessageChannel.PUSH existed as a channel nothing could deliver on. A token
/// belongs to a user (an organizer's app) or to a guest (a guest-facing app),
/// never both, and tokens are rotated by the platform, so the same device may
/// re-register with a new one.
model DeviceToken {
  id      String  @id @default(cuid())
  userId  String?
  guestId String?

  platform DevicePlatform
  /// APNs/FCM registration token. Unique so a re-registration replaces rather
  /// than duplicating, which would deliver the same notification twice.
  token    String         @unique

  appVersion String?
  locale     String?

  lastSeenAt DateTime  @default(now())
  /// Set when the platform reports the token as no longer valid.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest Guest? @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([guestId, revokedAt])
  @@map("device_tokens")
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ─────────────────────────── Guest list import ─────────────────────────

/// A host with four hundred guests will not type them in. An import is a
/// durable record of one upload so a partial failure can be reported per row
/// and retried without duplicating the rows that succeeded.
model GuestImport {
  id      String @id @default(cuid())
  eventId String

  filename     String
  status       ImportStatus @default(PENDING)
  rowsTotal    Int          @default(0)
  rowsImported Int          @default(0)
  rowsFailed   Int          @default(0)
  /// Per-row errors, so a host can fix twelve bad rows rather than re-upload
  /// four hundred good ones.
  errors       Json         @default("[]")

  uploadedBy String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  /// Also, in SQL only: a partial unique index allowing one PROCESSING import
  /// per event (guest_imports_one_running_per_event). Prisma cannot express it.
  @@map("guest_imports")
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

// ──────────────────── Account lifecycle (was missing) ──────────────────
//
// Authentication shipped without these, which left two ordinary things
// impossible: recovering a forgotten password, and adding a teammate to an
// organization without writing a row by hand.

/// A single-use, time-limited token for an account action. Only the hash is
/// stored, for the same reason as a refresh token: a database leak must not
/// hand over the ability to take over accounts.
model VerificationToken {
  id      String              @id @default(cuid())
  userId  String
  purpose VerificationPurpose

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

enum VerificationPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// An invitation to join an organization.
///
/// Separate from VerificationToken because the invitee may have no account
/// yet — the invitation is addressed to an email, and accepting it is what
/// creates the membership.
/// An invitation to work on one event — a coordinator, a designer, door staff.
/// The event-level counterpart of OrganizationInvite: accepting it grants an
/// EventMembership and nothing in the organization, so a florist's designer or
/// a venue's door staff see this event and no other.
model EventInvite {
  id              String    @id @default(cuid())
  eventId         String
  email           String
  role            EventRole
  invitedByUserId String?

  tokenHash String @unique

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// One live invitation per address per event; re-inviting replaces.
  @@unique([eventId, email])
  @@index([email])
  @@map("event_invites")
}

model OrganizationInvite {
  id              String           @id @default(cuid())
  organizationId  String
  email           String
  role            OrganizationRole
  invitedByUserId String?

  tokenHash String @unique

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// One live invitation per address per organization; re-inviting replaces.
  @@unique([organizationId, email])
  @@index([email])
  @@map("organization_invites")
}

// ───────────────────── Messaging suppression (was missing) ─────────────
//
// MessageStatus.SUPPRESSED existed with nothing behind it. Sending to someone
// who unsubscribed, or who hard-bounced, is a legal problem and a
// deliverability one.

model Suppression {
  id             String            @id @default(cuid())
  /// Null suppresses an address everywhere — a hard bounce or a complaint.
  /// Set suppresses it for one organization only — an ordinary unsubscribe.
  organizationId String?
  channel        MessageChannel
  /// Email address or phone number, normalised by the caller — or, once its
  /// owner's data is erased, `sha256:` and the hash of it (D15).
  address        String
  reason         SuppressionReason
  notes          String?
  createdAt      DateTime          @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Covers organization-scoped rows only: in Postgres two NULLs never
  /// conflict, so this constraint does not reach a global suppression. The
  /// global case is covered by a partial unique index created in
  /// `20261005190000_global_suppression_uniqueness` — Prisma cannot express a
  /// partial index, so it lives in SQL and must not be dropped.
  @@unique([organizationId, channel, address])
  @@index([channel, address])
  @@map("suppressions")
}

enum SuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  COMPLAINT
  MANUAL
  /// The person's data was erased. Kept per organization that held them, as a
  /// hash, so that host cannot import or message them again (D21).
  ERASED
}

// ───────────────── Subscription billing (PRODUCT_SPEC §9.4) ────────────
//
// The only recurring revenue line, and the one that turns Aveline from a
// transaction into infrastructure.

/// A purchasable plan. Entitlements live here as columns rather than in a
/// separate table: there are a handful of limits, they are read on nearly
/// every request, and a join to discover "may this account do that" is cost
/// with no benefit.
model Plan {
  id   String   @id @default(cuid())
  key  String   @unique
  name String
  tier PlanTier

  priceMinor BigInt
  currency   String          @default("AMD")
  interval   BillingInterval

  // ── entitlements ──
  maxEventsPerPeriod     Int?
  maxGuestsPerEvent      Int?
  maxLocales             Int      @default(1)
  /// How long a published invitation stays reachable after its event.
  /// Null means indefinitely, which is what a paid tier buys; free tiers
  /// carry a number captured at first publication to set
  /// Invitation.expiresAt after event end/start. See PRODUCT_SPEC §14.8.
  invitationLifetimeDays Int?
  /// Capability flags, e.g. ["seating", "vendor-briefs", "check-in"].
  features               String[] @default([])

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("plans")
}

enum PlanTier {
  INVITATION
  MANAGED
  PRODUCTION
  PLANNER
  CORPORATE
}

enum BillingInterval {
  MONTHLY
  YEARLY
  /// Charged per event rather than per period.
  PER_EVENT
}

model Subscription {
  id             String @id @default(cuid())
  organizationId String
  planId         String

  status SubscriptionStatus @default(TRIALING)

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  cancelledAt        DateTime?
  trialEndsAt        DateTime?

  /// Token the bank returns for a stored card. Recurring charges on Armenian
  /// gateways are card bindings, not a stored PAN — we never hold card data.
  /// See docs/PAYMENTS.md §7.
  bindingRef      String?
  bindingProvider PaymentProvider?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices     Invoice[]

  /// One live subscription per organization.
  @@unique([organizationId])
  /// The renewal sweep scans subscriptions whose period has lapsed.
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  /// Payment failed; access continues briefly while retries run.
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Invoice {
  id             String  @id @default(cuid())
  organizationId String
  subscriptionId String?
  /// The plan this invoice buys. Applied to the subscription only when it is
  /// paid: overwriting the subscription at issue meant paying an old invoice
  /// activated whatever plan the row held by then.
  planId         String?

  /// Human-facing, sequential, and never reused — a legal requirement in
  /// most jurisdictions, including for Armenian corporate customers.
  number String @unique

  status        InvoiceStatus @default(DRAFT)
  subtotalMinor BigInt
  taxMinor      BigInt        @default(0)
  totalMinor    BigInt
  currency      String        @default("AMD")

  /// Line items captured at issue, so a later price change never rewrites a
  /// document someone has already filed.
  lines Json @default("[]")

  issuedAt           DateTime?
  dueAt              DateTime?
  paidAt             DateTime?
  /// Links to the Payment that settled it, when one did.
  paymentOrderNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan         Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  /// Settlement and refunds find an invoice by its payment.
  @@index([paymentOrderNumber])
  /// Settlement reads ISSUED and VOID invoices across organizations.
  @@index([status])
  @@map("invoices")
}

/// Gap-free invoice numbering.
///
/// A sequence would be simpler but leaves gaps when a transaction rolls back,
/// and an unexplained gap in a numbered series is exactly what a tax audit
/// asks about. One row per series, incremented inside the same transaction
/// that writes the invoice, so a rolled-back invoice returns its number.
model InvoiceCounter {
  /// The series this counter belongs to, e.g. "2026".
  series String @id
  next   Int    @default(1)

  updatedAt DateTime @updatedAt

  @@map("invoice_counters")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  UNCOLLECTIBLE
}

// ───────────────────── Refunds as records, not a total ─────────────────

/// Payment.refundedMinor is a running total, which is enough to decide
/// whether another refund fits but loses the history. A dispute needs to know
/// what was refunded, when, and why.
model Refund {
  id        String @id @default(cuid())
  paymentId String

  amountMinor BigInt
  currency    String       @default("AMD")
  reason      String?
  status      RefundStatus @default(PENDING)

  providerRef       String?
  failureReason     String?
  requestedByUserId String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

// ───────────────────────── Ticketing: discounts ────────────────────────

model PromoCode {
  id             String  @id @default(cuid())
  organizationId String
  /// Null applies the code across the organization's events.
  eventId        String?

  code  String
  kind  DiscountKind
  /// Percent (1–100) or an amount in minor units, per `kind`.
  value BigInt

  maxRedemptions Int?
  redemptions    Int     @default(0)
  minOrderMinor  BigInt?

  validFrom  DateTime?
  validUntil DateTime?
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders       TicketOrder[]

  @@unique([organizationId, code])
  @@index([eventId, isActive])
  @@map("promo_codes")
}

enum DiscountKind {
  PERCENT
  FIXED
}

// ──────────────────────────── Exports ──────────────────────────────────

/// A generated document: a seating chart, place cards, a catering sheet.
///
/// A row rather than a synchronous download because generating a PDF for four
/// hundred guests is CPU-bound and must not run inside a request
/// (CLAUDE.md §5). The caller polls or is notified.
model Export {
  id      String @id @default(cuid())
  eventId String

  kind   ExportKind
  format ExportFormat
  status ExportStatus @default(QUEUED)

  /// The generated file, once there is one.
  assetId           String?
  failureReason     String?
  requestedByUserId String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  asset MediaAsset? @relation("ExportFile", fields: [assetId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@map("exports")
}

enum ExportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ExportKind {
  GUEST_LIST
  SEATING_CHART
  PLACE_CARDS
  CATERING_SHEET
  BAR_SHEET
  PLAYLIST
  TICKET_MANIFEST
}

enum ExportFormat {
  PDF
  CSV
  XLSX
}


/// A fixed private export generated by the dedicated worker. Legacy Export
/// rows retain their live-download contract during the frontend transition.
model ExportSnapshot {
  id String @id @default(cuid())
  eventId String
  requestedByUserId String
  idempotencyKey String
  kind ExportKind
  format ExportFormat @default(CSV)
  locale String
  includesContacts Boolean
  status ExportStatus @default(QUEUED)
  attempts Int @default(0)
  leaseOwner String?
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  failureReason String?
  snapshotAt DateTime?
  timezone String?
  attendanceRevision Int?
  dataRevision String?
  artifactKey String?
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  completedAt DateTime?
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artifacts ExportArtifact[]
  subjects ExportSnapshotSubject[]
  @@unique([eventId, requestedByUserId, idempotencyKey])
  @@index([eventId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
  @@map("export_snapshots")
}

/// Write-ahead object ledger. Survives event deletion and failed attempts.
/// Cleanup tombstones are retained: a delayed stale upload must still be
/// discoverable and removable, even after an earlier deletion succeeded.
model ExportArtifact {
  key String @id
  snapshotId String?
  cleanupAfter DateTime
  isRetired Boolean @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  snapshot ExportSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  @@index([cleanupAfter])
  @@index([snapshotId])
  @@map("export_artifacts")
}

/// Pseudonymous lookup catches old snapshots after a contact address changes.
model ExportSnapshotSubject {
  snapshotId String
  fingerprint String
  snapshot ExportSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  @@id([snapshotId, fingerprint])
  @@index([fingerprint])
  @@map("export_snapshot_subjects")
}

/// Serializes erasure against consistent capture and guarded publication.
model ExportPrivacyFence {
  id String @id
  revision Int @default(0)
  @@map("export_privacy_fences")
}


enum SeatingJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// Durable automatic seating. Application and completion commit together.
model SeatingJob {
  id String @id @default(cuid())
  eventId String
  arrangementId String
  requestedByUserId String
  idempotencyKey String
  status SeatingJobStatus @default(QUEUED)
  attempts Int @default(0)
  leaseOwner String?
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  failureReason String?
  snapshotAt DateTime?
  attendanceRevision Int?
  arrangementRevision Int?
  appliedRevision Int?
  result Json?
  createdAt DateTime @default(now())
  completedAt DateTime?
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  arrangement SeatingArrangement @relation(fields: [arrangementId, eventId], references: [id, eventId], onDelete: Cascade)
  @@unique([eventId, requestedByUserId, idempotencyKey])
  @@index([eventId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
  @@index([arrangementId])
  @@map("seating_jobs")
}


/// Immutable wording. Translation edits also create a new version.
model QuestionStatement {
  id String @id @default(cuid())
  questionId String
  revision Int
  prompt Json
  createdAt DateTime @default(now())
  question RsvpQuestion @relation("QuestionStatements", fields: [questionId], references: [id], onDelete: Cascade)
  currentFor RsvpQuestion? @relation("CurrentStatement")
  acknowledgements GuestAcknowledgement[]
  @@unique([questionId, revision])
  @@map("question_statements")
}

enum AcknowledgementMethod {
  TYPED
  DRAWN
}

model GuestAcknowledgement {
  id String @id @default(uuid())
  dedupeKey String @unique
  eventId String
  questionId String
  statementVersionId String
  subjectGuestId String
  signerGuestId String
  signerName String
  method AcknowledgementMethod
  isRepresentative Boolean @default(false)
  locale String
  statement String
  mediaId String?
  createdAt DateTime @default(now())
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question RsvpQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version QuestionStatement @relation(fields: [statementVersionId], references: [id], onDelete: Cascade)
  subject Guest @relation("AcknowledgementSubject", fields: [subjectGuestId], references: [id], onDelete: Cascade)
  signer Guest @relation("AcknowledgementSigner", fields: [signerGuestId], references: [id], onDelete: Cascade)
  media GuestMedia? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  @@index([eventId, createdAt, id])
  @@index([subjectGuestId, statementVersionId])
  @@index([signerGuestId])
  @@index([questionId])
  @@index([statementVersionId])
  @@index([mediaId])
  @@map("guest_acknowledgements")
}

enum GuestMediaKind {
  SIGNATURE
  GALLERY
}

enum GuestMediaStatus {
  STAGING
  QUEUED
  PROCESSING
  READY
  FAILED
  REMOVED
}

enum GalleryModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A private file ledger survives event/guest deletion to reclaim late writes.
model GuestMedia {
  id String @id @default(uuid())
  eventId String?
  uploaderGuestId String?
  kind GuestMediaKind
  processingStatus GuestMediaStatus @default(STAGING)
  moderationStatus GalleryModerationStatus @default(PENDING)
  sourceKey String @unique
  displayKey String? @unique
  thumbnailKey String? @unique
  mimeType String
  sourceBytes Int
  storedBytes Int
  reservedBytes Int
  width Int?
  height Int?
  caption String?
  attempts Int @default(0)
  claimToken String?
  leaseUntil DateTime?
  failureReason String?
  moderatedBy String?
  moderatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  removedAt DateTime?
  clearedAt DateTime?
  cleanupAfter DateTime @default(now())
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  uploader Guest? @relation(fields: [uploaderGuestId], references: [id], onDelete: SetNull)
  acknowledgements GuestAcknowledgement[]
  @@index([eventId, kind, processingStatus, createdAt, id])
  @@index([uploaderGuestId, kind, createdAt])
  @@index([processingStatus, leaseUntil, createdAt])
  @@index([cleanupAfter])
  @@map("guest_media")
}

// Writers append one change per event/transaction, avoiding lock upgrades on
// event rows and lock inversions with seating jobs. Compaction preserves totals.
model GuestPageVersion {
  eventId String @id
  revision BigInt @default(0)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@map("guest_page_versions")
}
model GuestPageChange {
  eventId String
  transactionId BigInt
  @@id([eventId, transactionId])
  @@map("guest_page_changes")
}

/// Independent payload counters: an RSVP invalidates its household, not every
/// guest's shared invitation. No parent FKs; maintenance reclaims orphan scopes.
model GuestPayloadVersion {
  eventId String
  scope String
  revision BigInt @default(0)
  @@id([eventId, scope])
  @@map("guest_payload_versions")
}

model GuestPayloadChange {
  eventId String
  scope String
  transactionId BigInt
  @@id([eventId, scope, transactionId])
  @@map("guest_payload_changes")
}

enum EnquiryStage {
  NEW
  CONTACTED
  CONSULTATION
  READY_FOR_QUOTE
  CLOSED
}

enum EnquirySource {
  PHONE
  MESSAGING
  IN_PERSON
  EMAIL
  OTHER
}

enum EnquiryClosureReason {
  CUSTOMER_DECLINED
  UNREACHABLE
  DUPLICATE
  OTHER
}

enum EnquiryClearanceReason {
  RETENTION
  VERIFIED_ERASURE
}

enum EnquiryAddressKind {
  EMAIL
  PHONE
}

enum EnquiryNoteKind {
  GENERAL
  CONSULTATION
}

enum ConsultationStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum OwnerInviteDeliveryState {
  PENDING
  QUEUED
  CANCELLED
  NEEDS_REVIEW
}

enum DataSubjectSource {
  EMAIL
  STAFF_ENQUIRY
}

model SalesEnquiry {
  id                    String                  @id @default(cuid())
  organizationId        String?
  eventId               String?
  assignedUserId        String?
  createdByUserId       String
  stage                 EnquiryStage            @default(NEW)
  revision              Int                     @default(1)
  eventType             EventType?
  approximateLocalDate  DateTime?               @db.Date
  approximateTimezone   String?                 @db.VarChar(64)
  estimatedGuestCount   Int?
  preferredLocale       String?                 @db.VarChar(2)
  source                EnquirySource?
  closedAt              DateTime?
  closureReason         EnquiryClosureReason?
  closureNote           String?                 @db.VarChar(2000)
  cleanupDueAt          DateTime?
  personalDataClearedAt DateTime?
  clearanceReason       EnquiryClearanceReason?
  privacyRevision       Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  organization          Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event                 Event?                  @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignedUser          User?                   @relation(fields: [assignedUserId], references: [id], onDelete: Restrict)
  contact               EnquiryContact?
  notes                 EnquiryNote[]
