  @@unique([id, enquiryId])
  @@index([enquiryId, startsAt(sort: Desc), id(sort: Desc)])
  @@map("consultations")
}

model EnquiryActivity {
  id              String       @id @default(cuid())
  enquiryId       String
  enquiryRevision Int
  actorUserId     String?
  kind            String
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now())
  enquiry         SalesEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)

  @@unique([enquiryId, enquiryRevision])
  @@index([enquiryId, enquiryRevision(sort: Desc)])
  @@map("enquiry_activities")
}

model EnquiryCommand {
  id                 String        @id @default(cuid())
  actorUserId        String
  operation          String
  idempotencyKey     String        @db.VarChar(128)
  requestFingerprint String?
  enquiryId          String?
  resultId           String?
  appliedRevision    Int
  responseStatus     Int
  createdAt          DateTime      @default(now())
  invalidatedAt      DateTime?
  enquiry            SalesEnquiry? @relation(fields: [enquiryId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, operation, idempotencyKey])
  @@map("enquiry_commands")
}

model EnquiryConversion {
  id                String       @id @default(cuid())
  enquiryId         String       @unique
  organizationId    String
  eventId           String?
  ownerInviteId     String?
  convertedByUserId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  enquiry           SalesEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event             Event?       @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@map("enquiry_conversions")
}

model OwnerInviteDelivery {
  id                   String                   @id @default(cuid())
  organizationInviteId String                   @unique
  enquiryId            String?
  privacyRevision      Int
  sourceContactId      String?
  state                OwnerInviteDeliveryState @default(PENDING)
  messageId            String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  enquiry              SalesEnquiry?            @relation(fields: [enquiryId], references: [id], onDelete: Restrict)

  @@index([state, createdAt])
  @@map("owner_invite_deliveries")
}

model EnquiryPrivacyFence {
  id       String @id @default("intake")
  revision Int    @default(0)

  @@map("enquiry_privacy_fences")
}

model EnquiryErasureTombstone {
  enquiryId       String
  contactId       String
  privacyRevision Int
  createdAt       DateTime @default(now())
  sourceRequestId String?

  @@id([enquiryId, contactId])
  @@map("enquiry_erasure_tombstones")
}

model EnquiryPrivacyRedaction {
  id                 String                 @id @default(cuid())
  enquiryId          String
  contactId          String
  reason             EnquiryClearanceReason
  privacyRevision    Int
  redactedAt         DateTime
  checkpointSequence BigInt?                @unique
  checkpointedAt     DateTime?

  @@index([checkpointedAt, redactedAt])
  @@map("enquiry_privacy_redactions")
}

model DataSubjectRequestEnquirySubject {
  requestId String
  contactId String
  request   DataSubjectRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  contact   EnquiryContact     @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@id([requestId, contactId])
  @@map("data_subject_request_enquiry_subjects")
}
