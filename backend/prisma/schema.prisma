  enquiry         SalesEnquiry    @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  consultation    Consultation?   @relation(fields: [consultationId, enquiryId], references: [id, enquiryId], onDelete: Restrict)

  @@index([enquiryId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("enquiry_notes")
