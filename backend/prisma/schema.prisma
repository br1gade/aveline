  kind        EnquiryAddressKind
  fingerprint String
  createdAt   DateTime           @default(now())
  contact     EnquiryContact     @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@id([contactId, kind, fingerprint])
  @@index([kind, fingerprint, contactId])
