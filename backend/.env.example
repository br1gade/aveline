# Copy to .env and adjust. Never commit .env.
DATABASE_URL="postgresql://aveline:aveline@localhost:5433/aveline?schema=public"
PORT=3000
NODE_ENV=development

# Public base URL used to build guest invitation links
PUBLIC_BASE_URL="http://localhost:3000"

# Redis — hot-path cache, rate limits, job queue. Ports avoid host defaults.
REDIS_URL="redis://localhost:6380"
# Cached invitation payload lifetime, seconds. Writes invalidate immediately,
# so this is only a backstop against a missed invalidation.
INVITATION_CACHE_TTL=300

# MongoDB — append-only analytics. Never the core domain; see docs/DATA_STORES.md
MONGO_URL="mongodb://aveline:aveline@localhost:27018/aveline?authSource=admin"
ANALYTICS_ENABLED=true
ANALYTICS_READ_TIMEOUT_MS=300

# ── Payments ──────────────────────────────────────────────────────────
# A provider is registered only when its username is set, so leaving these
# blank disables that bank rather than failing at the moment someone pays.
# All three require merchant credentials issued by the bank. See docs/PAYMENTS.md
AMERIA_BASE_URL="https://servicestest.ameriabank.am"
AMERIA_CLIENT_ID=
AMERIA_USERNAME=
AMERIA_PASSWORD=

INECO_BASE_URL="https://ipaytest.inecobank.am"
INECO_USERNAME=
INECO_PASSWORD=

IDBANK_BASE_URL="https://ipayproxy.idp.am"
IDBANK_USERNAME=
IDBANK_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────
# The app refuses to boot in production without JWT_SECRET: a default here
# would let anyone mint a staff token.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── Storage ───────────────────────────────────────────────────────────
STORAGE_ROOT="./storage"
STORAGE_PUBLIC_URL="/files"

# ── Storage ───────────────────────────────────────────────────────────
# Set these and the API uses S3-compatible object storage; leave them blank
# and it falls back to the local filesystem, which is correct for exactly one
# instance. Locally these point at Garage (docker compose up -d garage); in
# production at whichever bucket you run. See docs/STORAGE.md to generate the
# credentials — they are per-deployment and never committed.
S3_ENDPOINT="http://localhost:3900"
S3_REGION="garage"
S3_BUCKET="aveline-media"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL="http://aveline-media.web.garage.localhost:3902"

# ── Logging ───────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
# Defaults to debug in development, info in production.
LOG_LEVEL=

# ── Error reporting ───────────────────────────────────────────────────
# Leave blank and Sentry stays off — which is how development stays quiet.
# Tracing and profiling are deliberately not enabled.
SENTRY_DSN=
SENTRY_RELEASE=

# ── Mail ──────────────────────────────────────────────────────────────
# Development points at the Mailpit container from docker-compose: real SMTP,
# nothing leaves the machine, and the inbox is at http://localhost:8025.
# Production uses Google Workspace SMTP (smtp.gmail.com:587 with an app
# password). Leaving SMTP_HOST unset falls back to logging email instead of
# sending it, which NODE_ENV=production refuses to boot with.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Aveline <hello@aveline.test>"

# ── Chat channels ─────────────────────────────────────────────────────
# Telegram is free and needs no approval: create a bot with @BotFather and
# paste its token. A bot can only message someone who has started a
# conversation with it, so guests arrive through the deep link in their
# emailed invitation. TELEGRAM_BOT_USERNAME builds that link, and
# TELEGRAM_WEBHOOK_SECRET authenticates Telegram's calls to us — required in
# production whenever a bot token is set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp needs a Meta Business account, a verified business, a dedicated
# number and message templates approved in advance. Both values come from the
# Meta app dashboard; one without the other is treated as unconfigured.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Deployment ────────────────────────────────────────────────────────
# How many reverse proxies sit in front of the app. 0 trusts nothing, which is
# right when running directly. Set to 1 behind the Caddy container, or the
# rate limiter treats the whole internet as one client.
TRUST_PROXY_HOPS=0
