{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    // Named explicitly. TypeScript 6 no longer pulls every @types package in
    // automatically, and relying on that implicit behaviour is how a stray
    // transitive @types package starts changing the build. `multer` is here
    // for the `Express.Multer.File` global it augments onto Express, which
    // the upload endpoints are typed against.
    "types": ["node", "jest", "express", "multer"]
  },
  "exclude": ["node_modules", "dist"]
}
