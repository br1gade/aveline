    "/api/v1/events/{eventId}/media": {
      "post": {
        "description": "Assets are scoped to an event, so deleting the event reclaims its storage and no asset is reachable from an unrelated invitation.",
        "operationId": "MediaController_upload",
        "parameters": [
          {
            "name": "eventId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "PHOTO",
                      "COVER",
                      "SIGNATURE",
                      "LOGO",
                      "AUDIO",
                      "DOCUMENT"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Upload an image or audio file for an event",
        "tags": [
          "media"
        ]
      }
    },
