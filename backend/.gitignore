# Backend-local ignores (see repo root .gitignore for the rest)
node_modules/
dist/
coverage/
.env
*.tsbuildinfo
/storage/
/.backup/

# Local development keys, written down so they are not lost between sessions
.dev-credentials.md

# Garage node config — contains rpc_secret and admin_token
garage/garage.toml
!garage/garage.toml.example
# This build definition is source; the root *.backup pattern is for data files.
!Dockerfile.backup
