{
  "name": "@aveline/backend",
  "version": "0.1.0",
  "description": "Aveline backend — event invitations, guest graph and operations",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "db:up": "docker compose up -d postgres redis mongo garage mailpit",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test:unit": "jest --runInBand",
    "test:int": "jest --config ./test/jest-integration.json --runInBand",
    "test:all": "npm run test:unit && npm run test:int && npm run test:e2e",
    "lint:fix": "eslint . --fix",
    "verify": "npm run lint && npm run docs:check && npm run openapi:check && npm run build && npm run test:pilot && npm run test:all",
    "docs:check": "node scripts/check-docs.mjs",
    "test:edge": "node scripts/test-edge.mjs",
    "test:backup": "node --test --test-isolation=none scripts/backup.test.mjs scripts/check-backup.test.mjs",
    "backup:rehearsal": "node scripts/backup-rehearsal.mjs",
    "pilot:smoke": "node scripts/pilot-smoke.mjs",
    "pilot:rehearsal": "node scripts/pilot-rehearsal.mjs",
    "storage:up": "docker compose up -d garage && ./scripts/garage-bootstrap.sh",
    "openapi": "ts-node scripts/export-openapi.ts",
    "openapi:check": "ts-node scripts/export-openapi.ts --check",
    "seed:production": "ts-node src/seed-production.ts",
    "start:export-worker": "node --max-old-space-size=384 dist/export-worker.js",
    "start:seating-worker": "node --max-old-space-size=256 dist/seating-worker.js",
    "start:template-asset-worker": "node --max-old-space-size=256 dist/template-asset-worker.js",
    "start:private-media-worker": "node --max-old-space-size=256 dist/private-media-worker.js",
    "pilot:cache": "ts-node scripts/personalized-cache-rehearsal.ts",
    "test:pilot": "node --test --test-isolation=none scripts/pilot/*.test.mjs",
    "pilot:production-rehearsal": "node scripts/pilot/run.mjs"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-node": "2.8.0",
    "@prisma/client": "^6.19.3",
    "@prisma/instrumentation": "6.19.3",
    "@sentry/nestjs": "^11.5.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.3",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "nanoid": "^3.3.8",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.0.16",
    "pdfkit": "0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "fflate": "0.8.3",
    "jest": "^30.5.2",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=24"
  }
}
