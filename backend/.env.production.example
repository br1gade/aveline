# Aveline in production.
#
# Copy to .env.production on the host, fill in, and keep it off git — it is
# the only place these secrets exist. See docs/DEPLOYMENT.md.
#
#   cp .env.production.example .env.production && chmod 600 .env.production

NODE_ENV=production
PORT=3000

# ── The domain ────────────────────────────────────────────────────────
# Caddy obtains a certificate for API_DOMAIN, so its DNS must already point
# at this host or the first start will fail to get one.
API_DOMAIN=api.aveline.am
ACME_EMAIL=ops@aveline.am

# Which origins may call the API with a user's credentials. The app refuses
# to boot in production without this, because an open policy lets any site
# act as a signed-in user.
CORS_ORIGINS=https://aveline.am,https://www.aveline.am

# Where guests and hosts reach the client. Used to build the links in email.
PUBLIC_APP_URL=https://aveline.am

# ── Secrets ───────────────────────────────────────────────────────────
# Generate, do not invent:  openssl rand -base64 48
JWT_SECRET=

POSTGRES_USER=aveline
POSTGRES_PASSWORD=
POSTGRES_DB=aveline
DATABASE_URL=postgresql://aveline:CHANGE_ME@postgres:5432/aveline?schema=public

MONGO_USER=aveline
MONGO_PASSWORD=
MONGO_DB=aveline
MONGO_URL=mongodb://aveline:CHANGE_ME@mongo:27017/aveline?authSource=admin

REDIS_URL=redis://redis:6379
REDIS_MAXMEMORY=512mb

# ── Mail ──────────────────────────────────────────────────────────────
# The app refuses to boot in production without SMTP_HOST and MAIL_FROM,
# because an invitation written to a log file looks exactly like one that was
# delivered. Google Workspace: smtp.gmail.com:587 with an app password, or
# smtp-relay.gmail.com for a large guest list.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Aveline <hello@aveline.am>"

# ── Chat channels (optional) ──────────────────────────────────────────
# A bot token requires TELEGRAM_WEBHOOK_SECRET in production: without it
# anyone guessing a guest token could register their own chat for that guest.
# With no secret the webhook refuses every update outside development.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# SMS is built provider-neutral: name the provider here once one is chosen and
# its adapter exists (backend/src/modules/communications/channels/sms.transport.ts).
# Unset, SMS is never chosen. A name Aveline has no adapter for refuses to boot.
# Numbers written the local way (091…) take SMS_DEFAULT_COUNTRY_CODE.
SMS_PROVIDER=
SMS_DEFAULT_COUNTRY_CODE=374

# ── Storage ───────────────────────────────────────────────────────────
STORAGE_DRIVER=s3
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=aveline-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_URL=https://media.aveline.am

# ── Operations ────────────────────────────────────────────────────────
SENTRY_DSN=
# One proxy in front: Caddy. The compose file sets this for the api service.
TRUST_PROXY_HOPS=1

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# Until this is set, backups live only on this host and do not survive losing
# it. Anything that copies /backups elsewhere, e.g.
#   rclone sync /backups remote:aveline-backups
BACKUP_SYNC_COMMAND=
