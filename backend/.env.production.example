# Aveline in production.
#
# Copy to .env.production on the host, fill in, and keep it off git — it is
# the only place these secrets exist. See docs/DEPLOYMENT.md.
#
#   cp .env.production.example .env.production && chmod 600 .env.production

NODE_ENV=production
PILOT_MODE=true
PORT=3000

# ── The domain ────────────────────────────────────────────────────────
# Caddy obtains a certificate for API_DOMAIN, so its DNS must already point
# at this host or the first start will fail to get one.
API_DOMAIN=api.aveline.am
MEDIA_DOMAIN=media.aveline.am
MEDIA_BUCKET_HOST=aveline-media.web.garage.localhost
ACME_EMAIL=ops@aveline.am

# Which origins may call the API with a user's credentials. The app refuses
# to boot in production without this, because an open policy lets any site
# act as a signed-in user.
CORS_ORIGINS=https://aveline.am,https://www.aveline.am

# Where guests and hosts reach the client. Used to build the links in email.
PUBLIC_APP_URL=https://aveline.am

# ── Secrets ───────────────────────────────────────────────────────────
# Generate, do not invent:  openssl rand -base64 48
JWT_SECRET=

POSTGRES_USER=aveline
POSTGRES_PASSWORD=
POSTGRES_DB=aveline
# connection_limit is per API process; keep (processes × limit) under
# Postgres's max_connections (100 by default) with room for migrations and
# backups. Unset, Prisma takes 2 × CPUs + 1, which changes with the host.
# pool_timeout fails a request that waited 10 s for a connection, rather
# than letting it queue for ever under load.
DATABASE_URL=postgresql://aveline:CHANGE_ME@postgres:5432/aveline?schema=public&connection_limit=20&pool_timeout=10

MONGO_USER=aveline
MONGO_PASSWORD=
MONGO_DB=aveline
MONGO_URL=mongodb://aveline:CHANGE_ME@mongo:27017/aveline?authSource=admin

REDIS_URL=redis://redis:6379
REDIS_MAXMEMORY=512mb

# ── Mail ──────────────────────────────────────────────────────────────
# The app refuses to boot in production without SMTP_HOST and MAIL_FROM,
# because an invitation written to a log file looks exactly like one that was
# delivered. Google Workspace: smtp.gmail.com:587 with an app password, or
# smtp-relay.gmail.com for a large guest list.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Aveline <hello@aveline.am>"
# Conservative defaults; adjust to the selected provider's actual limits.
EMAIL_SENDS_PER_MINUTE=60
EMAIL_SENDS_PER_DAY=1000
EMAIL_SEND_BURST=5
EMAIL_SEND_CONCURRENCY=3
# Optional normalized feedback bridge. At least 32 random characters.
# No native provider adapter is selected; leave unset until one is configured.
EMAIL_FEEDBACK_SECRET=

# ── Chat channels (optional) ──────────────────────────────────────────
# A bot token requires TELEGRAM_WEBHOOK_SECRET in production: without it
# anyone guessing a guest token could register their own chat for that guest.
# With no secret the webhook refuses every update outside development.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Configure all six together; no API version default. See docs/WHATSAPP_SETUP.md.
WHATSAPP_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# SMS is built provider-neutral: name the provider here once one is chosen and
# its adapter exists (backend/src/modules/communications/channels/sms.transport.ts).
# Unset, SMS is never chosen. A name Aveline has no adapter for refuses to boot.
# Numbers written the local way (091…) take SMS_DEFAULT_COUNTRY_CODE.
SMS_PROVIDER=
SMS_DEFAULT_COUNTRY_CODE=374

# ── Storage ───────────────────────────────────────────────────────────
STORAGE_DRIVER=s3
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=aveline-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://media.aveline.am

# ── Operations ────────────────────────────────────────────────────────
SENTRY_DSN=
# One proxy in front: Caddy. The compose file sets this for the api service.
TRUST_PROXY_HOPS=1

BACKUP_RETENTION_DAYS=14
BACKUP_REMOTE_KEEP_DAILY=14
BACKUP_REMOTE_KEEP_WEEKLY=8
BACKUP_REMOTE_KEEP_MONTHLY=12
BACKUP_MAX_AGE_HOURS=30
BACKUP_MIN_FREE_BYTES=10737418240
BACKUP_MAX_USED_PERCENT=90
# Initialize the encrypted repository before enabling the timer.
# e.g. s3:https://a-separate-provider.example/bucket/aveline
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Credentials for the recovery repository, not local Garage media.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Private exports, drawings and gallery bucket: grant API/workers read+write, and
# NEVER enable anonymous reads/website hosting. Required in production with S3.
PRIVATE_S3_BUCKET=aveline-private
# Filesystem fallback only; API and worker must share this volume. Keep it
# outside STORAGE_ROOT and all static/media web server roots.
PRIVATE_STORAGE_ROOT=./private-storage
# Generated bytes expire; source event data is retained.
EXPORT_RETENTION_DAYS=7

# Optional private media worker heartbeat override (container-local file).
PRIVATE_MEDIA_WORKER_HEARTBEAT_PATH=/tmp/aveline-private-media-worker-heartbeat
