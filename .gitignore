#  OTHER LANGUAGES
# =============================================================

# Ruby
.bundle/
vendor/bundle/
*.gem
.byebug_history

# Go
*.exe
*.exe~
*.dll
*.test
*.out
vendor/

# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Java / Kotlin / Gradle / Maven
*.class
*.jar
*.war
*.ear
.gradle/
gradle-app.setting
.mvn/timing.properties
target/

# PHP / Composer
/vendor/
composer.phar
.phpunit.result.cache

# =============================================================
