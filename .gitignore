# =============================================================
*.sqlite
*.sqlite3
*.db
*.db-journal
*.rdb
dump.rdb
*.sql.gz
/data/
/backups/

# =============================================================
#  LOGS, TEMP & ARCHIVES
# =============================================================
*.log
logs/
*.pid
*.seed
*.pid.lock
tmp/
temp/
.tmp/
scratch/
scratchpad/
*.bak
*.backup
*.old
*.orig
*.rej
*.swp

# Archives (usually build artifacts or downloads)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# =============================================================
#  INFRASTRUCTURE & TOOLING
# =============================================================
.terraform/
*.tfstate
*.tfstate.*
.terragrunt-cache/
.serverless/
.pulumi/
docker-compose.override.yml
.dockerignore.local

# =============================================================
#  CLAUDE CODE / AI TOOLING
# =============================================================
.claude/settings.local.json
.claude/.credentials.json
.claudeignore.local
.aider*
.cursorignore.local
